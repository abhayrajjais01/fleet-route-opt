# AI Fleet Route Optimizer - Environment Variables
APP_NAME="AI Fleet Route Optimizer"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
# Defaults to zero-config SQLite file: sqlite:///./fleet_opt.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/fleet_opt
DATABASE_URL="sqlite:///./fleet_opt.db"

# Security & JWT Token Config
SECRET_KEY="supersecret_fleet_optimizer_jwt_key_development_only_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Binding
HOST="0.0.0.0"
PORT=8000

# ─── API hardening (Week 14, Track B) — see app/core/http_security.py and documentation/SECURITY_AUDIT.md ───
# Per-client limits, requests per minute. Each uvicorn worker keeps its own counters.
RATE_LIMIT_ENABLED=True
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AI_PER_MIN=60
RATE_LIMIT_EXPORT_PER_MIN=20
RATE_LIMIT_DEFAULT_PER_MIN=600
# Only behind the bundled Nginx (docker compose), which overwrites X-Real-IP on every request.
TRUST_PROXY_HEADERS=False
MAX_REQUEST_BYTES=10485760
# Extra browser origins as a JSON list, e.g. ["https://fleet.example.com"]. Vercel previews of this project are
# matched by BACKEND_CORS_ORIGIN_REGEX.
# BACKEND_CORS_ORIGINS=["http://localhost:3000"]
# POST /auth/seed-demo-users (published passwords). Unset: on in development, off when APP_ENV=production.
# DEMO_ACCOUNTS_ENABLED=False
