# AI Fleet Route Optimizer - Environment Variables
APP_NAME="AI Fleet Route Optimizer"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
# Defaults to zero-config SQLite file: sqlite:///./fleet_opt.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/fleet_opt
DATABASE_URL="sqlite:///./fleet_opt.db"

# Security & JWT Token Config
SECRET_KEY="supersecret_fleet_optimizer_jwt_key_development_only_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Binding
HOST="0.0.0.0"
PORT=8000
